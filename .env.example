# Copy to .env for local overrides (Vite loads .env/.env.local
# automatically - no restart-time export needed like the backend). Vite
# only exposes variables prefixed VITE_ to client code, and inlines them at
# build time, so this must be set correctly before `npm run build` for
# production - see DEPLOYMENT.md.

# Base URL of the backend API - no trailing slash, no /api or /auth suffix
# (services/api.js appends those itself). Falls back to
# http://localhost:8801 if unset, so local dev works with zero setup.
VITE_API_BASE_URL=http://localhost:8801
